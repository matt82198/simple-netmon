# vigil configuration — copy to config.env and edit as needed.
# All values are optional; defaults are shown.

# ── Detection thresholds ──────────────────────────────────────────────────────

# Seconds between polls. Lowering to 1 shrinks the window for short-lived
# process detection but increases CPU/disk overhead.
POLL_INTERVAL=5

# Number of initial polls to run silently (no alerts) while building a
# baseline of normal egress processes.
WARMUP_POLLS=5

# Known-bad IPs — comma-separated, no spaces around commas.
# No defaults are shipped. Add your own threat intel here.
# Example: IOC_IPS=192.0.2.1,198.51.100.5
IOC_IPS=

# Alert when a single process holds this many simultaneous outbound connections.
PARALLEL_EXFIL_THRESHOLD=10

# Alert when a process that had outbound connections exits within this many seconds.
SHORT_LIVED_THRESHOLD=30

# How many past polls to include when determining whether a process is "new".
# Higher = longer memory but slower adaptation after installs.
NEW_PROCESS_LOOKBACK=5

# ── Privacy / scope ───────────────────────────────────────────────────────────

# Set to false to also monitor RFC-1918 / loopback destinations.
# Useful for detecting lateral movement on internal networks.
FILTER_PRIVATE=true

# ── OAuth / MCP detection ─────────────────────────────────────────────────────

# Comma-separated OAuth/identity provider domains that trigger OAUTH_PROVIDER_CONTACT.
# Leave blank to use the built-in defaults (Google, Microsoft, GitHub, Slack, etc.)
OAUTH_PROVIDER_DOMAINS=

# Comma-separated process names exempt from OAuth chain rules (browsers).
# Leave blank to use the built-in defaults (chrome.exe, msedge.exe, firefox.exe, etc.)
OAUTH_BROWSER_PROCS=

# Comma-separated executable root paths for browser ancestry validation.
# Leave blank to use the built-in defaults (Program Files browser install dirs).
# Set to a custom path if using a non-standard browser install location.
OAUTH_BROWSER_PATHS=

# Comma-separated MCP/AI infrastructure endpoint patterns for MCP_CONNECTOR_TRAFFIC.
# Leave blank to use built-in defaults (api.anthropic.com, claude.ai, etc.)
MCP_ENDPOINT_HOST_PATTERNS=

# Number of seconds in the OAuth chain detection window.
OAUTH_CHAIN_WINDOW_SECS=60

# Minimum distinct OAuth providers contacted within the window to fire OAUTH_PROVIDER_CHAIN.
OAUTH_CHAIN_THRESHOLD=2

# Set to true to fall back to reverse DNS (socket.getnameinfo) when the OS
# DNS cache has no record for a remote IP. Default: false (secure-by-default;
# reverse DNS PTR records can be spoofed).
DNS_REVERSE_LOOKUP_ENABLED=false

# ── Alerting channels ─────────────────────────────────────────────────────────

# Leave blank to disable Discord notifications.
# Format: https://discord.com/api/webhooks/<id>/<token>
DISCORD_WEBHOOK_URL=

# Set to false to suppress Windows toast notifications (e.g. on a headless host).
# Requires winotify to be installed; silently ignored if the package is absent.
TOAST_ENABLED=true

# Minimum alert severity to deliver via Discord/toast. Alerts below this threshold
# are still logged to the log file.
# Values: INFO | MEDIUM | HIGH | CRITICAL (default: MEDIUM)
ALERT_MIN_SEVERITY=MEDIUM

# ── Logging ───────────────────────────────────────────────────────────────────

# Absolute path to log file. Defaults to netmon.log in the script directory.
# LOG_PATH=~/vigil/netmon.log

LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3

# ── IP allowlist ──────────────────────────────────────────────────────────────
# Comma-separated IPs/CIDRs to exempt from BASELINE_IP_DEVIATION. Independent
# from EGRESS_ALLOWLIST (process-based) and IOC_IPS (IOC matches still fire even
# if the IP is allowlisted here — these lists are never AND'd).
# Bare IPv4 = /32, bare IPv6 = /128. Both v4 and v6 networks supported.
# Leave blank to disable.
# Example entries:
#   203.0.113.10/32      RFC 5737 documentation IP (example; replace with your own)
#   192.0.2.0/24         RFC 5737 documentation range (example)
EGRESS_IP_ALLOWLIST=

# ── Baseline / training ───────────────────────────────────────────────────────
# Run `python netmon.py --train 3600` to build a 1-hour baseline before monitoring.

# Absolute path to baseline.json. Defaults to baseline.json in the script directory.
# BASELINE_PATH=

# Suppress IP-deviation alerts for processes with more than N distinct IPs in baseline.
# Prevents browser/CDN noise. Default: 50.
BASELINE_SUPPRESS_CDN_THRESHOLD=50

# ── Real-time defense (opt-in) ────────────────────────────────────────────────
# When enabled, vigil injects a Windows Defender Firewall outbound block rule
# for the remote IP on CRITICAL-severity detections.
# Requires an elevated process. Default: disabled.

# Set to true to enable the defender (requires elevated process on Windows).
DEFENDER_ENABLED=false

# Set to false to execute real firewall actions. Default: true (dry-run only).
DEFENDER_DRY_RUN=true

# ── Elevation note ────────────────────────────────────────────────────────────
# psutil.net_connections() on Windows may return pid=None for connections owned
# by SYSTEM or other privileged services when running as a standard user.
# Run pythonw.exe elevated (or set RunLevel=Highest in the scheduled task) to
# get full PID attribution for all connections.
